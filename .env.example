# Copia este archivo a .env.local (ya ignorado por git) y configura los valores reales.
# En Vercel: Project Settings → Environment Variables (scope Production/Preview).

# Server-side only — usada por api/jotai-chat.js. Nunca exponer al cliente.
OPENAI_API_KEY=

# Opcional — restringe qué Origin/Referer puede llamar a api/jotai-chat.js.
# Si se deja vacío, no se aplica el chequeo.
ALLOWED_ORIGIN=

# Opcional — reporta el uso de OPENAI_API_KEY (tokens/costo/latencia) a LLM
# Observatory. Mismas variables que usa api/llm-stats.js y api/jotai-log.js
# (este último reporta ahí el historial de matches locales de JotAI, sin
# costo). Si se dejan vacías, ninguno de los dos reporta nada pero JotAI
# funciona igual.
LLM_OBSERVATORY_API_URL=
LLM_OBSERVATORY_API_TOKEN=
